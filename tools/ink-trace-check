#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
for validator in \
  "${TINYDRAW_INK_TRACE_CHECK:-}" \
  "$root/out/build/host-debug/vector_v2/tinydraw_ink_trace_check" \
  "$root/out/build/host-release/vector_v2/tinydraw_ink_trace_check" \
  "$root/out/build/host-asan/vector_v2/tinydraw_ink_trace_check"
do
  if [ -n "$validator" ] && [ -x "$validator" ]; then
    exec "$validator" "$@"
  fi
done

echo "ink-trace validator is not built; run:" >&2
echo "  cmake --preset host-debug && cmake --build --preset host-debug --target tinydraw_ink_trace_check" >&2
exit 2
