# Physical Waveshare boards use the ESP32-S3R8's in-package octal PSRAM.
# Display/touch revision (V1 vs V2) is independent of this memory mode.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
# A 64-byte D-cache line matches the long sequential PSRAM transfers used by
# raster buffers and panel staging. The physical gate improves without changing
# the 32 KiB cache allocation or export-time internal-heap reserve.
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_FREERTOS_HZ=1000
# Matches the gate-harness stack so harness receipts speak for product
# stack safety (the two configurations previously diverged 10 KiB vs 16 KiB).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
