#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ $# -gt 1 ]]; then
  echo "usage: $0 [PUCK_REPO]" >&2
  exit 2
fi

puck="${1:-${PUCK_REPO:-}}"
if [[ -z "$puck" ]]; then
  for candidate in "$root/../puck" "$root/../puck-upstream"; do
    if [[ -f "$candidate/src/wasm.ts" ]]; then
      puck="$candidate"
      break
    fi
  done
fi
if [[ -z "$puck" || ! -f "$puck/src/wasm.ts" ]]; then
  echo "Puck checkout not found; pass its path or set PUCK_REPO" >&2
  exit 1
fi
puck="$(cd "$puck" && pwd)"

build="$root/out/build/puck"
mkdir -p "$root/out/build"
build_lock="$root/out/build/.puck.lock"
if ! mkdir "$build_lock" 2>/dev/null; then
  echo "another Puck build is already using $build" >&2
  exit 1
fi
release_build_lock() { rmdir "$build_lock" 2>/dev/null || true; }
trap release_build_lock EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

cxx="${WASI_CXX:-}"
if [[ -z "$cxx" && -x /opt/homebrew/opt/llvm/bin/clang++ ]]; then
  cxx=/opt/homebrew/opt/llvm/bin/clang++
fi
if [[ -z "$cxx" || ! -x "$cxx" ]]; then
  echo "WASI clang++ not found; run ./scripts/bootstrap-wasm or set WASI_CXX" >&2
  exit 1
fi
command -v bun >/dev/null 2>&1 || { echo "bun is required to verify Puck" >&2; exit 1; }

cmake -S "$root" -B "$build" -G Ninja \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_SYSTEM_NAME=Generic \
  -DCMAKE_CXX_COMPILER="$cxx" \
  -DCMAKE_CXX_COMPILER_TARGET=wasm32-wasip1 \
  -DTINYDRAW_PUCK_ABI_INCLUDE_DIR="$puck/wasm" \
  -DTINYDRAW_BUILD_HOST=OFF \
  -DTINYDRAW_BUILD_TESTS=OFF \
  -DTINYDRAW_BUILD_PUCK=ON \
  -DTINYDRAW_WARNINGS_AS_ERRORS=ON
cmake --build "$build" --target tinydraw_puck

module="$build/puck/emu.wasm"
bun "$root/puck/loader_verify.mjs" "$module" "$puck"
bun "$root/puck/verify.mjs" "$puck"
release_build_lock
trap - EXIT INT TERM HUP

if [[ $# == 0 && -z "${PUCK_REPO:-}" ]]; then
  echo "built and verified $module"
  exit 0
fi

destination="$puck/wasm/dist/emu.wasm"
mkdir -p "$(dirname "$destination")"
staged="$(mktemp "${destination}.tmp.XXXXXX")"
backup=""
had_destination=0
installed=0
cleanup() {
  rm -f "$staged"
  if [[ $installed -eq 1 ]]; then
    if [[ $had_destination -eq 1 ]]; then
      mv -f "$backup" "$destination"
    else
      rm -f "$destination"
    fi
  elif [[ -n "$backup" ]]; then
    rm -f "$backup"
  fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

cp "$module" "$staged"
if [[ -f "$destination" ]]; then
  had_destination=1
  backup="$(mktemp "${destination}.backup.XXXXXX")"
  cp -p "$destination" "$backup"
fi
mv -f "$staged" "$destination"
installed=1

bun "$root/puck/loader_verify.mjs" "$destination" "$puck"
(
  cd "$puck"
  bun run typecheck
  bun run test:wasi
  bun run verify
)

installed=0
if [[ -n "$backup" ]]; then rm -f "$backup"; fi
trap - EXIT INT TERM HUP
echo "installed and verified $destination"
