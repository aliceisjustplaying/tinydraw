#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
version="$(tr -d '[:space:]' < "$root/.idf-version")"

if ! command -v brew >/dev/null 2>&1; then
  echo "Homebrew is required: https://brew.sh" >&2
  exit 1
fi

if ! command -v eim >/dev/null 2>&1; then
  brew tap espressif/eim
  brew install eim
fi

eim install -i "$version"

if ! find "$HOME/.espressif/tools" -path '*qemu-system-xtensa' -type f -perm -111 -print -quit | grep -q .; then
  eim run 'python "$IDF_PATH/tools/idf_tools.py" install qemu-xtensa'
fi

cat <<EOF
ESP-IDF $version and ESP32-S3 QEMU are installed in their isolated environment.
Use the project wrappers rather than sourcing ESP-IDF globally:
  ./scripts/esp32 build
  ./scripts/esp32 qemu
EOF
