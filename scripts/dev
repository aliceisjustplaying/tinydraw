#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

command_name="${1:-test}"

configure_build_test() {
  local preset="$1"
  cmake --preset "$preset"
  cmake --build --preset "$preset"
  ctest --preset "$preset"
}

case "$command_name" in
  test)
    configure_build_test host-debug
    ;;
  asan)
    configure_build_test host-asan
    ;;
  release)
    configure_build_test host-release
    ;;
  run|run-2x|run-3x)
    scale="${2:-1}"
    if [[ "$command_name" == run-2x ]]; then scale=2; fi
    if [[ "$command_name" == run-3x ]]; then scale=3; fi
    if [[ ! "$scale" =~ ^[123]$ ]]; then
      echo "scale must be 1, 2, or 3" >&2
      exit 2
    fi
    cmake --preset host-debug
    cmake --build --preset host-debug --target tinydraw_host
    exec "$root/out/build/host-debug/host/tinydraw_host" --scale "$scale"
    ;;
  perf)
    cmake --preset host-release
    cmake --build --preset host-release --target tinydraw_perf_characterization
    exec "$root/out/build/host-release/tests/tinydraw_perf_characterization"
    ;;
  vector-perf)
    cmake --preset host-release
    cmake --build --preset host-release --target tinydraw_vector_rebuild_benchmark
    exec "$root/out/build/host-release/tests/tinydraw_vector_rebuild_benchmark"
    ;;
  format|format-check)
    formatter="${CLANG_FORMAT:-}"
    if [[ -z "$formatter" ]]; then
      formatter="$(command -v clang-format || true)"
    fi
    if [[ -z "$formatter" && -x /opt/homebrew/opt/llvm/bin/clang-format ]]; then
      formatter=/opt/homebrew/opt/llvm/bin/clang-format
    fi
    if [[ -z "$formatter" ]]; then
      echo "clang-format not found; run ./scripts/bootstrap-macos" >&2
      exit 1
    fi
    mapfile_supported=false
    if builtin help mapfile >/dev/null 2>&1; then mapfile_supported=true; fi
    if [[ "$mapfile_supported" == true ]]; then
      mapfile -t files < <(find core vector_v2 host tests esp32/main rp2350/src -type f \( -name '*.cpp' -o -name '*.h' \) | sort)
    else
      files=()
      while IFS= read -r file; do files+=("$file"); done < <(find core vector_v2 host tests esp32/main rp2350/src -type f \( -name '*.cpp' -o -name '*.h' \) | sort)
    fi
    if [[ "$command_name" == format ]]; then
      "$formatter" -i "${files[@]}"
    else
      "$formatter" --dry-run --Werror "${files[@]}"
    fi
    ;;
  tidy)
    tidy="${CLANG_TIDY:-}"
    if [[ -z "$tidy" ]]; then
      tidy="$(command -v clang-tidy || true)"
    fi
    if [[ -z "$tidy" && -x /opt/homebrew/opt/llvm/bin/clang-tidy ]]; then
      tidy=/opt/homebrew/opt/llvm/bin/clang-tidy
    fi
    if [[ -z "$tidy" ]]; then
      echo "clang-tidy not found; run ./scripts/bootstrap-macos" >&2
      exit 1
    fi
    cmake --preset host-debug
    files=()
    while IFS= read -r file; do files+=("$file"); done < <(find vector_v2 -type f -name '*.cpp' | sort)
    if [[ ${#files[@]} -eq 0 ]]; then
      echo "No Vector V2 C++ implementation files to analyze yet."
      exit 0
    fi
    tidy_args=(--quiet -p "$root/out/build/host-debug")
    if [[ "$(uname -s)" == Darwin ]] && command -v xcrun >/dev/null 2>&1; then
      tidy_args+=(--extra-arg=-isysroot --extra-arg="$(xcrun --show-sdk-path)")
    fi
    for file in "${files[@]}"; do
      "$tidy" "${tidy_args[@]}" "$file"
    done
    ;;
  cppcheck)
    checker="${CPPCHECK:-}"
    if [[ -z "$checker" ]]; then
      checker="$(command -v cppcheck || true)"
    fi
    if [[ -z "$checker" ]]; then
      echo "cppcheck not found; run ./scripts/bootstrap-macos" >&2
      exit 1
    fi
    files=()
    while IFS= read -r file; do files+=("$file"); done < <(find vector_v2 -type f \( -name '*.cpp' -o -name '*.h' \) | sort)
    if [[ ${#files[@]} -eq 0 ]]; then
      echo "No Vector V2 C++ files to analyze yet."
      exit 0
    fi
    "$checker" --quiet --std=c++20 --language=c++ --check-level=exhaustive \
      --enable=warning,style,performance,portability --error-exitcode=1 --inline-suppr \
      --suppress=missingIncludeSystem --suppress=unusedStructMember \
      -I "$root/vector_v2/include" "${files[@]}"
    ;;
  *)
    echo "usage: $0 {test|run|run-2x|run-3x|perf|vector-perf|asan|release|format|format-check|tidy|cppcheck}" >&2
    exit 2
    ;;
esac
