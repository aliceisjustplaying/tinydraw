#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

is_puck_repo() {
  [[ -f "$1/package.json" && -f "$1/server.ts" && -d "$1/wasm" ]]
}

is_puck_page() {
  [[ "$1" == *'<title>device emulator</title>'* &&
    "$1" == *'id="deviceName"'* &&
    "$1" == *'<canvas id="panel"'* ]]
}

is_quit_ack() {
  [[ "$1" == *'"ok":true'* && "$1" == *'"stopping":true'* ]]
}

open_puck_url() {
  if [[ "$(uname -s)" == "Darwin" ]] && command -v open >/dev/null 2>&1; then
    open "$1"
  fi
}

main() {
  if [[ $# -gt 1 ]]; then
    echo "usage: $0 [PUCK_REPO]" >&2
    exit 2
  fi

  local puck="${1:-${PUCK_REPO:-}}"
  if [[ -z "$puck" ]]; then
    local workspace_parent
    workspace_parent="$(cd "$root/../.." && pwd)"
    local candidates=(
      "$root/../puck-upstream"
      "$root/../puck"
      "$workspace_parent/a/puck-upstream"
      "$workspace_parent/puck-upstream"
      "$workspace_parent/puck"
    )
    local candidate
    for candidate in "${candidates[@]}"; do
      if is_puck_repo "$candidate"; then
        puck="$candidate"
        break
      fi
    done
  fi

  if [[ -z "$puck" ]] || ! is_puck_repo "$puck"; then
    echo "Puck checkout not found; pass its path or set PUCK_REPO" >&2
    exit 1
  fi
  puck="$(cd "$puck" && pwd)"

  if ! command -v bun >/dev/null 2>&1; then
    echo "bun is required to run the Puck development server" >&2
    exit 1
  fi
  if ! command -v curl >/dev/null 2>&1; then
    echo "curl is required to probe the Puck development server" >&2
    exit 1
  fi

  "$root/scripts/puck" "$puck"

  local url="http://127.0.0.1:5340"
  local page
  if page="$(curl --silent --show-error --max-time 2 "$url/" 2>/dev/null)"; then
    if ! is_puck_page "$page"; then
      echo "$url is already in use by a non-Puck server; stop it or free port 5340" >&2
      exit 1
    fi
    echo "stopping the existing Puck server at $url"
    local quit_ack
    if ! quit_ack="$(curl --fail --silent --show-error --max-time 2 \
      --request POST --header 'x-puck-emulator: 1' "$url/api/quit")" ||
      ! is_quit_ack "$quit_ack"; then
      echo "the existing Puck server did not accept guarded /api/quit; stop it manually" >&2
      exit 1
    fi
    local closed=0
    for _ in {1..50}; do
      if ! curl --silent --max-time 1 "$url/" >/dev/null 2>&1; then
        closed=1
        break
      fi
      sleep 0.1
    done
    if [[ $closed -ne 1 ]]; then
      echo "the existing Puck server accepted /api/quit but port 5340 stayed open" >&2
      exit 1
    fi
  fi

  local server_pid=""
  cleanup() {
    if [[ -n "${server_pid:-}" ]] && kill -0 "$server_pid" 2>/dev/null; then
      kill -TERM "$server_pid" 2>/dev/null || true
      wait "$server_pid" 2>/dev/null || true
    fi
  }
  trap cleanup EXIT INT TERM HUP

  (
    cd "$puck"
    exec bun run dev
  ) &
  server_pid=$!

  local ready=0
  local exit_code
  for _ in {1..150}; do
    if ! kill -0 "$server_pid" 2>/dev/null; then
      if wait "$server_pid"; then
        exit_code=1
      else
        exit_code=$?
      fi
      echo "Puck development server exited before becoming ready" >&2
      exit "$exit_code"
    fi
    if page="$(curl --silent --show-error --max-time 1 "$url/" 2>/dev/null)"; then
      if ! is_puck_page "$page"; then
        echo "$url responded, but it is not the Puck emulator; free port 5340" >&2
        exit 1
      fi
      # Confirm the process we started still owns a live server. This closes
      # the race where an older listener answers while the new Bun process is
      # failing with EADDRINUSE.
      sleep 0.05
      if ! kill -0 "$server_pid" 2>/dev/null; then
        wait "$server_pid" || true
        echo "Puck development server lost the port during startup" >&2
        exit 1
      fi
      ready=1
      break
    fi
    sleep 0.1
  done
  if [[ $ready -ne 1 ]]; then
    echo "Puck server did not become ready at $url within 15 seconds" >&2
    exit 1
  fi

  echo "TinyDraw V2 in Puck -> $url (Ctrl-C to stop)"
  open_puck_url "$url"

  wait "$server_pid"
  server_pid=""
  trap - EXIT INT TERM HUP
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
