#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
raster_v1_build="$root/out/build/esp32-raster-v1"
qemu_build="$root/out/build/esp32-qemu"
graphics_build="$root/out/build/esp32-graphics"
vector_v2_build="$root/out/build/esp32-vector-v2"
demo_build="$root/out/build/esp32-vector-v2-demo"
gate_harness_build="$root/out/build/esp32-vector-v2-gate-harness"
tile_census_build="$root/out/build/esp32-vector-v2-tile-census"
tearing_probe_build="$root/out/build/esp32-vector-v2-tearing-probe"
panel_probe_build="$root/out/build/esp32-panel-probe"
action="${1:-build}"

if ! command -v eim >/dev/null 2>&1; then
  echo "eim is required; run ./scripts/bootstrap-idf" >&2
  exit 1
fi

assert_config() {
  local config="$1"
  local memory_mode="$2"
  grep -q '^CONFIG_COMPILER_OPTIMIZATION_PERF=y$' "$config"
  grep -q '^CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240$' "$config"
  grep -q "^CONFIG_SPIRAM_MODE_${memory_mode}=y$" "$config"
}

enable_qemu() {
  local executable
  executable="$(find "$HOME/.espressif/tools" -path '*qemu-system-xtensa' -type f ! -name '._*' -perm -111 -print -quit)"
  if [[ -z "$executable" ]]; then
    echo "qemu-system-xtensa is required; run ./scripts/bootstrap-idf" >&2
    exit 1
  fi
  export PATH="$(dirname "$executable"):$PATH"
}

case "$action" in
  build)
    cd "$root/esp32"
    eim run "idf.py -B '$vector_v2_build' -DTINYDRAW_FIRMWARE_VARIANT=product build"
    assert_config "$vector_v2_build/sdkconfig" OCT
    ;;
  raster-v1)
    port="${2:-}"
    cd "$root/esp32"
    eim run "idf.py -B '$raster_v1_build' -DTINYDRAW_FIRMWARE_VARIANT=raster-v1 build"
    assert_config "$raster_v1_build/sdkconfig" OCT
    if [[ -n "$port" ]]; then
      eim run "idf.py -B '$raster_v1_build' -p '$port' flash"
    fi
    ;;
  vector-v2)
    port="${2:-}"
    if [[ -z "$port" ]]; then
      echo "usage: $0 vector-v2 PORT" >&2
      exit 2
    fi
    rm -rf "$vector_v2_build"
    cd "$root/esp32"
    eim run "idf.py -B '$vector_v2_build' -DTINYDRAW_FIRMWARE_VARIANT=product build"
    assert_config "$vector_v2_build/sdkconfig" OCT
    eim run "idf.py -B '$vector_v2_build' -p '$port' flash"
    ;;
  vector-v2-demo)
    port="${2:-}"
    rm -rf "$demo_build"
    cd "$root/esp32"
    eim run "idf.py -B '$demo_build' -DTINYDRAW_FIRMWARE_VARIANT=demo build"
    assert_config "$demo_build/sdkconfig" OCT
    if [[ -n "$port" ]]; then
      eim run "idf.py -B '$demo_build' -p '$port' flash"
    fi
    ;;
  vector-v2-gate-harness)
    port="${2:-}"
    slots="${3:-604}"
    verify="${4:-}"
    if [[ -z "$port" ]]; then
      echo "usage: $0 vector-v2-gate-harness PORT [TILE_SLOTS] [verify]" >&2
      exit 2
    fi
    rm -rf "$gate_harness_build"
    cd "$root/esp32"
    eim run "idf.py -B '$gate_harness_build' -DTINYDRAW_FIRMWARE_VARIANT=gate -DTINYDRAW_VECTOR_V2_TILE_SLOTS=$slots build"
    assert_config "$gate_harness_build/sdkconfig" OCT
    grep -q '^CONFIG_ESP_MAIN_TASK_STACK_SIZE=20480$' "$gate_harness_build/sdkconfig"
    eim run "idf.py -B '$gate_harness_build' -p '$port' flash"
    if [[ "$verify" == "verify" ]]; then
      # Capture the battery and parse the verdict: flashing alone is not a
      # gate result.
      log=/tmp/gate-verify.log
      cd "$root"
      uv run --script tools/esp32-capture.py "$port" "$log" 480 \
        --end-marker TINYDRAW_GATE1_AUTOMATED_DONE \
        --failure-regex 'task_wdt|Guru Meditation|TG1WDT_SYS_RST|stack overflow'
      done_line=$(grep TINYDRAW_GATE1_AUTOMATED_DONE "$log" | tail -1 || true)
      if [[ -z "$done_line" ]]; then
        echo "GATE VERIFY FAILED: no TINYDRAW_GATE1_AUTOMATED_DONE in $log" >&2
        exit 1
      fi
      if grep -qE 'task_wdt|Guru Meditation|TG1WDT_SYS_RST|stack overflow' "$log"; then
        echo "GATE VERIFY FAILED: watchdog or crash in $log" >&2
        exit 1
      fi
      if echo "$done_line" | grep -q '=0'; then
        echo "GATE VERIFY FAILED: red gate in verdict: $done_line" >&2
        exit 1
      fi
      echo "GATE VERIFY PASSED: $done_line"
    fi
    ;;
  panel-probe)
    port="${2:-}"
    cell="${3:-0}"
    if [[ -z "$port" ]]; then
      echo "usage: $0 panel-probe PORT [CELL 0-6]" >&2
      echo "cells: 0=software suite, 1=boundary-rising-full, 2=boundary-falling-full, 3=midframe-wrap-rising, 4=freerun-unsynced (positive control), 5=boundary-rising-canvas368, 6=cycle 4,1,5,2,3 in one take" >&2
      exit 2
    fi
    cd "$root/esp32"
    eim run "idf.py -B '$panel_probe_build' -DTINYDRAW_FIRMWARE_VARIANT=panel-probe -DTINYDRAW_PANEL_PROBE_CELL='$cell' build"
    assert_config "$panel_probe_build/sdkconfig" OCT
    eim run "idf.py -B '$panel_probe_build' -p '$port' flash"
    ;;
  vector-v2-tearing-probe)
    port="${2:-}"
    if [[ -z "$port" ]]; then
      echo "usage: $0 vector-v2-tearing-probe PORT" >&2
      exit 2
    fi
    rm -rf "$tearing_probe_build"
    cd "$root/esp32"
    eim run "idf.py -B '$tearing_probe_build' -DTINYDRAW_FIRMWARE_VARIANT=tearing-probe build"
    assert_config "$tearing_probe_build/sdkconfig" OCT
    eim run "idf.py -B '$tearing_probe_build' -p '$port' flash"
    ;;
  vector-v2-tile-census)
    port="${2:-}"
    if [[ -z "$port" ]]; then
      echo "usage: $0 vector-v2-tile-census PORT" >&2
      exit 2
    fi
    rm -rf "$tile_census_build"
    cd "$root/esp32"
    eim run "idf.py -B '$tile_census_build' -DTINYDRAW_FIRMWARE_VARIANT=tile-census build"
    assert_config "$tile_census_build/sdkconfig" OCT
    eim run "idf.py -B '$tile_census_build' -p '$port' flash"
    ;;
  qemu)
    enable_qemu
    cd "$root/esp32"
    eim run "idf.py -B '$qemu_build' -DTINYDRAW_FIRMWARE_VARIANT=qemu build"
    assert_config "$qemu_build/sdkconfig" QUAD
    python3 "$root/tools/qemu-replay.py" --build "$qemu_build"
    ;;
  graphics|graphics-test)
    enable_qemu
    cd "$root/esp32"
    eim run "idf.py -B '$graphics_build' -DTINYDRAW_FIRMWARE_VARIANT=qemu -DTINYDRAW_QEMU_GRAPHICS=ON build"
    assert_config "$graphics_build/sdkconfig" QUAD
    if [[ "$action" == graphics-test ]]; then
      python3 "$root/tools/qemu-replay.py" --build "$graphics_build" --graphics
    else
      echo "Close QEMU with Ctrl-A, then X."
      eim run "idf.py -B '$graphics_build' qemu --graphics --qemu-extra-args '-m 8M'"
    fi
    ;;
  clean)
    rm -rf "$raster_v1_build" "$demo_build" "$qemu_build" "$graphics_build" "$vector_v2_build" "$gate_harness_build" "$tile_census_build" "$tearing_probe_build" "$panel_probe_build"
    ;;
  *)
    echo "usage: $0 {build|raster-v1 [PORT]|vector-v2 PORT|vector-v2-demo [PORT]|vector-v2-gate-harness PORT [TILE_SLOTS] [verify]|vector-v2-tearing-probe PORT|panel-probe PORT [CELL]|vector-v2-tile-census PORT|qemu|graphics|graphics-test|clean}" >&2
    exit 2
    ;;
esac
