#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
raster_v1_build="$root/out/build/esp32-raster-v1"
qemu_build="$root/out/build/esp32-qemu"
graphics_build="$root/out/build/esp32-graphics"
vector_build="$root/out/build/esp32-vector-benchmark"
interactive_pan_build="$root/out/build/esp32-interactive-pan-benchmark"
overview_walk_build="$root/out/build/esp32-vector-v2-overview-walk"
memory_probe_build="$root/out/build/esp32-vector-v2-memory-probe"
vector_v2_build="$root/out/build/esp32-vector-v2"
gate_harness_build="$root/out/build/esp32-vector-v2-gate-harness"
tile_census_build="$root/out/build/esp32-vector-v2-tile-census"
action="${1:-build}"

if ! command -v eim >/dev/null 2>&1; then
  echo "eim is required; run ./scripts/bootstrap-idf" >&2
  exit 1
fi

assert_config() {
  local config="$1"
  local memory_mode="$2"
  grep -q '^CONFIG_COMPILER_OPTIMIZATION_PERF=y$' "$config"
  grep -q '^CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240$' "$config"
  grep -q "^CONFIG_SPIRAM_MODE_${memory_mode}=y$" "$config"
}

enable_qemu() {
  local executable
  executable="$(find "$HOME/.espressif/tools" -path '*qemu-system-xtensa' -type f ! -name '._*' -perm -111 -print -quit)"
  if [[ -z "$executable" ]]; then
    echo "qemu-system-xtensa is required; run ./scripts/bootstrap-idf" >&2
    exit 1
  fi
  export PATH="$(dirname "$executable"):$PATH"
}

case "$action" in
  build|raster-v1)
    cd "$root/esp32"
    eim run "idf.py -B '$raster_v1_build' -DTINYDRAW_VECTOR_BENCHMARK=OFF -DTINYDRAW_PHASE2_PROTOTYPE=OFF -DTINYDRAW_RASTER_PAN_BENCHMARK=OFF -DTINYDRAW_INTERACTIVE_PAN_BENCHMARK=OFF -DTINYDRAW_VECTOR_V2_MEMORY_PROBE=OFF -DTINYDRAW_VECTOR_V2_OVERVIEW_WALK=OFF -DTINYDRAW_VECTOR_V2_APP=OFF build"
    assert_config "$raster_v1_build/sdkconfig" OCT
    ;;
  vector-benchmark)
    port="${2:-}"
    if [[ -z "$port" ]]; then
      echo "usage: $0 vector-benchmark PORT" >&2
      exit 2
    fi
    cd "$root/esp32"
    eim run "idf.py -B '$vector_build' -DTINYDRAW_VECTOR_BENCHMARK=ON build"
    assert_config "$vector_build/sdkconfig" OCT
    eim run "idf.py -B '$vector_build' -p '$port' flash"
    ;;
  interactive-pan-benchmark)
    port="${2:-}"
    if [[ -z "$port" ]]; then
      echo "usage: $0 interactive-pan-benchmark PORT" >&2
      exit 2
    fi
    cd "$root/esp32"
    eim run "idf.py -B '$interactive_pan_build' -DTINYDRAW_INTERACTIVE_PAN_BENCHMARK=ON build"
    assert_config "$interactive_pan_build/sdkconfig" OCT
    eim run "idf.py -B '$interactive_pan_build' -p '$port' flash"
    ;;
  vector-v2-overview-walk)
    port="${2:-}"
    if [[ -z "$port" ]]; then
      echo "usage: $0 vector-v2-overview-walk PORT" >&2
      exit 2
    fi
    rm -rf "$overview_walk_build"
    cd "$root/esp32"
    eim run "idf.py -B '$overview_walk_build' -DTINYDRAW_QEMU=OFF -DTINYDRAW_VECTOR_BENCHMARK=OFF -DTINYDRAW_PHASE2_PROTOTYPE=OFF -DTINYDRAW_RASTER_PAN_BENCHMARK=OFF -DTINYDRAW_INTERACTIVE_PAN_BENCHMARK=OFF -DTINYDRAW_VECTOR_V2_MEMORY_PROBE=OFF -DTINYDRAW_VECTOR_V2_OVERVIEW_WALK=ON build"
    assert_config "$overview_walk_build/sdkconfig" OCT
    eim run "idf.py -B '$overview_walk_build' -p '$port' flash"
    ;;
  vector-v2-memory-probe)
    port="${2:-}"
    if [[ -z "$port" ]]; then
      echo "usage: $0 vector-v2-memory-probe PORT" >&2
      exit 2
    fi
    rm -rf "$memory_probe_build"
    cd "$root/esp32"
    eim run "idf.py -B '$memory_probe_build' -DTINYDRAW_QEMU=OFF -DTINYDRAW_VECTOR_BENCHMARK=OFF -DTINYDRAW_PHASE2_PROTOTYPE=OFF -DTINYDRAW_RASTER_PAN_BENCHMARK=OFF -DTINYDRAW_INTERACTIVE_PAN_BENCHMARK=OFF -DTINYDRAW_VECTOR_V2_MEMORY_PROBE=ON -DTINYDRAW_VECTOR_V2_OVERVIEW_WALK=OFF -DTINYDRAW_VECTOR_V2_APP=OFF build"
    assert_config "$memory_probe_build/sdkconfig" OCT
    eim run "idf.py -B '$memory_probe_build' -p '$port' flash"
    ;;
  vector-v2)
    port="${2:-}"
    if [[ -z "$port" ]]; then
      echo "usage: $0 vector-v2 PORT" >&2
      exit 2
    fi
    rm -rf "$vector_v2_build"
    cd "$root/esp32"
    eim run "idf.py -B '$vector_v2_build' -DTINYDRAW_QEMU=OFF -DTINYDRAW_VECTOR_BENCHMARK=OFF -DTINYDRAW_PHASE2_PROTOTYPE=OFF -DTINYDRAW_RASTER_PAN_BENCHMARK=OFF -DTINYDRAW_INTERACTIVE_PAN_BENCHMARK=OFF -DTINYDRAW_VECTOR_V2_MEMORY_PROBE=OFF -DTINYDRAW_VECTOR_V2_OVERVIEW_WALK=OFF -DTINYDRAW_VECTOR_V2_APP=ON -DTINYDRAW_VECTOR_V2_GATE_HARNESS=OFF -DTINYDRAW_VECTOR_V2_TILE_CENSUS=OFF build"
    assert_config "$vector_v2_build/sdkconfig" OCT
    eim run "idf.py -B '$vector_v2_build' -p '$port' flash"
    ;;
  vector-v2-gate-harness)
    port="${2:-}"
    if [[ -z "$port" ]]; then
      echo "usage: $0 vector-v2-gate-harness PORT" >&2
      exit 2
    fi
    rm -rf "$gate_harness_build"
    cd "$root/esp32"
    eim run "idf.py -B '$gate_harness_build' -DTINYDRAW_QEMU=OFF -DTINYDRAW_VECTOR_BENCHMARK=OFF -DTINYDRAW_PHASE2_PROTOTYPE=OFF -DTINYDRAW_RASTER_PAN_BENCHMARK=OFF -DTINYDRAW_INTERACTIVE_PAN_BENCHMARK=OFF -DTINYDRAW_VECTOR_V2_MEMORY_PROBE=OFF -DTINYDRAW_VECTOR_V2_OVERVIEW_WALK=OFF -DTINYDRAW_VECTOR_V2_APP=ON -DTINYDRAW_VECTOR_V2_GATE_HARNESS=ON -DTINYDRAW_VECTOR_V2_TILE_CENSUS=OFF build"
    assert_config "$gate_harness_build/sdkconfig" OCT
    eim run "idf.py -B '$gate_harness_build' -p '$port' flash"
    ;;
  vector-v2-tile-census)
    port="${2:-}"
    if [[ -z "$port" ]]; then
      echo "usage: $0 vector-v2-tile-census PORT" >&2
      exit 2
    fi
    rm -rf "$tile_census_build"
    cd "$root/esp32"
    eim run "idf.py -B '$tile_census_build' -DTINYDRAW_QEMU=OFF -DTINYDRAW_VECTOR_BENCHMARK=OFF -DTINYDRAW_PHASE2_PROTOTYPE=OFF -DTINYDRAW_RASTER_PAN_BENCHMARK=OFF -DTINYDRAW_INTERACTIVE_PAN_BENCHMARK=OFF -DTINYDRAW_VECTOR_V2_MEMORY_PROBE=OFF -DTINYDRAW_VECTOR_V2_OVERVIEW_WALK=OFF -DTINYDRAW_VECTOR_V2_APP=ON -DTINYDRAW_VECTOR_V2_GATE_HARNESS=ON -DTINYDRAW_VECTOR_V2_TILE_CENSUS=ON build"
    assert_config "$tile_census_build/sdkconfig" OCT
    eim run "idf.py -B '$tile_census_build' -p '$port' flash"
    ;;
  qemu)
    enable_qemu
    cd "$root/esp32"
    eim run "idf.py -B '$qemu_build' -DTINYDRAW_QEMU=ON build"
    assert_config "$qemu_build/sdkconfig" QUAD
    python3 "$root/tools/qemu-replay.py" --build "$qemu_build"
    ;;
  graphics|graphics-test)
    enable_qemu
    cd "$root/esp32"
    eim run "idf.py -B '$graphics_build' -DTINYDRAW_QEMU=ON -DTINYDRAW_QEMU_GRAPHICS=ON build"
    assert_config "$graphics_build/sdkconfig" QUAD
    if [[ "$action" == graphics-test ]]; then
      python3 "$root/tools/qemu-replay.py" --build "$graphics_build" --graphics
    else
      echo "Close QEMU with Ctrl-A, then X."
      eim run "idf.py -B '$graphics_build' qemu --graphics --qemu-extra-args '-m 8M'"
    fi
    ;;
  clean)
    rm -rf "$raster_v1_build" "$qemu_build" "$graphics_build" "$vector_build" "$interactive_pan_build" "$overview_walk_build" "$memory_probe_build" "$vector_v2_build" "$gate_harness_build" "$tile_census_build"
    ;;
  *)
    echo "usage: $0 {build|raster-v1|vector-v2 PORT|vector-benchmark PORT|interactive-pan-benchmark PORT|vector-v2-overview-walk PORT|vector-v2-memory-probe PORT|vector-v2-gate-harness PORT|vector-v2-tile-census PORT|qemu|graphics|graphics-test|clean}" >&2
    exit 2
    ;;
esac
