#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
build="$root/out/build/esp32"
action="${1:-build}"

if ! command -v eim >/dev/null 2>&1; then
  echo "eim is required; run ./scripts/bootstrap-idf" >&2
  exit 1
fi

case "$action" in
  build)
    cd "$root/esp32"
    eim run "idf.py -B '$build' build"
    ;;
  qemu)
    "$0" build
    python3 "$root/tools/qemu-replay.py"
    ;;
  clean)
    rm -rf "$build" "$root/esp32/sdkconfig"
    ;;
  *)
    echo "usage: $0 {build|qemu|clean}" >&2
    exit 2
    ;;
esac
