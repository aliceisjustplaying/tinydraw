+        x = unsigned_decimal(values[2], UINT16_MAX, line_number, "x")
+        y = unsigned_decimal(values[3], UINT16_MAX, line_number, "y")
         kind = values[1]
-        if timestamp < 0:
-            raise ValueError(f"line {line_number}: timestamp must be non-negative")
