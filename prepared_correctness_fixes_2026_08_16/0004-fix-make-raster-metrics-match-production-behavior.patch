+UINT16_MAX = (1 << 16) - 1
+UINT32_MAX = (1 << 32) - 1
+UINT64_MAX = (1 << 64) - 1
+
+
+def unsigned_decimal(text: str, maximum: int, line_number: int, field: str) -> int:
+    if not text or any(character < "0" or character > "9" for character in text):
+        raise ValueError(f"line {line_number}: {field} is not an unsigned ASCII decimal")
+    value = int(text, 10)
+    if value > maximum:
+        raise ValueError(f"line {line_number}: {field} is out of range")
+    return value
 
 
 def fields(line: str, count: int, line_number: int) -> list[str]:
@@ -32,10 +44,7 @@ def parse_trace(path: Path) -> tuple[dict[str, str], list[tuple[int, str, int, i
