+std::uint32_t include_word(std::uint32_t hash, std::uint32_t word) {
+  for (unsigned shift = 0U; shift < 32U; shift += 8U) {
+    hash = (hash ^ static_cast<std::uint8_t>(word >> shift)) * kHashPrime;
