{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "TINYDRAW_BUILD_HOST": "ON",
        "TINYDRAW_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "host-debug",
      "inherits": "host-base",
      "displayName": "Host debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "host-asan",
      "inherits": "host-base",
      "displayName": "Host ASan + UBSan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TINYDRAW_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "host-release",
      "inherits": "host-base",
      "displayName": "Host release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "host-debug", "configurePreset": "host-debug" },
    { "name": "host-asan", "configurePreset": "host-asan" },
    { "name": "host-release", "configurePreset": "host-release" }
  ],
  "testPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "host-asan",
      "configurePreset": "host-asan",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "host-release",
      "configurePreset": "host-release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
